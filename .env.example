# Copy to .env and fill in. Never commit .env.

# ── Client-safe (bundled into the SPA via VITE_ prefix) ──
VITE_SANITY_PROJECT_ID=your-project-id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-02-19
# Optional: where /studio redirects (defaults to https://vecoders.sanity.studio)
# VITE_STUDIO_URL=https://vecoders.sanity.studio

# ── Server-only (Vercel functions / scripts) — NEVER prefix with VITE_ ──
SANITY_PROJECT_ID=your-project-id
SANITY_CONTENT_DATASET=production
SANITY_REGISTRATIONS_DATASET=registrations
SANITY_API_VERSION=2025-02-19
SANITY_WRITE_TOKEN=

# Google Sheets bridge (scripts/google-apps-script/Code.gs, deployed as a web app)
GOOGLE_SCRIPT_URL=
# Must match the SHARED_SECRET script property. Generate with: openssl rand -hex 32
GOOGLE_SCRIPT_SECRET=

# Secret set on the Sanity "event created" webhook (sanity.io/manage → API → Webhooks)
SANITY_WEBHOOK_SECRET=
